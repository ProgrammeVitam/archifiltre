# === Dependencies ===
node_modules/
bun.lockb

# === Build Output ===
dist/
build/
*.tsbuildinfo

# === Compiled Binary ===
archifiltre
archifiltre.exe

# === TypeScript ===
*.js
*.js.map
*.d.ts
!*.config.js
!*.config.mjs


# === Test Coverage ===
coverage/
.nyc_output/

# === Environment ===
.env
.env.local
.env.*.local

# === Logs ===
logs/
*.log
npm-debug.log*
bun-debug.log*
lerna-debug.log*

# Development logs (when NODE_ENV=development)
/logs/

# Database files
dbdata-*/
# Warm-start template (a pre-initialized PGDATA the first scan copies instead of running
# initdb) + its ready marker — regenerated on demand, in-repo only in dev.
.dbtemplate/
.dbtemplate.ready
*.sqlite
*.db

# === Temp/Cache ===
.cache/
tmp/
temp/
*.tmp
*.temp

# === OS Generated ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# === IDE/Editor ===
.vscode/
.idea/
*.swp
*.swo
*~

# === Config Files (keep most, ignore sensitive) ===
!.editorconfig
!.eslintrc.*
!.prettierrc*
!tsconfig.json
!vitest.config.ts

# === Archifiltre Specific ===
# Keep user config directory tests but ignore actual user data
test-output/
*.analysis.json
*.scan.json

# Scan reports generated at root level
scan-report-*.json
scan-report-*.csv
scan-report-*.html

# Reports directory contents (but keep the directory structure)
reports/*
!reports/.gitignore
!reports/README.md

# SBOM files generated during build
*.sbom
archifiltre.sbom

# === Security Reports ===
security-reports/

# Test folder
testfolder-*

# WASM binaries (copied from node_modules)
wasm_binaries/
ai-summaries/

# Local dev scratch (not for publication)
dbdata-docs-demo.meta.json
scripts/smoke-test-llm.ts
ui/src/routes/dev-numberflow/

# Fetched at build time by scripts/assemble-llm-runtime.sh, never committed
ui/src-tauri/vendor/
