{
  "name": "archifiltre",
  "version": "5.0.0-dev",
  "description": "Privacy-friendly, 100% offline desktop tool for inventorying large file trees",
  "type": "module",
  "bin": {
    "archifiltre": "./bin/run.js"
  },
  "scripts": {
    "dev": "bun run bin/dev.js",
    "build:cli": "bun build src/cli/bundle-entry.ts --compile --outfile archifiltre",
    "smoke:cli": "bun run scripts/smoke-test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "lint": "eslint src test scripts --ext .ts && eslint bin --ext .js && eslint .github --ext .yml,.yaml",
    "lint:fix": "eslint src test scripts --ext .ts --fix && eslint bin --ext .js --fix && eslint .github --ext .yml,.yaml --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:pack": "bun run scripts/release-pack.ts",
    "typecheck": "tsc --noEmit",
    "security:audit": "bun run scripts/security-audit.ts",
    "security:audit:ci": "bun run scripts/security-audit.ts --ci --severity high",
    "security:audit:json": "bun run scripts/security-audit.ts --json --output security-report.json",
    "security:audit:quick": "bun run scripts/security-audit.ts --skip-semgrep --quiet"
  },
  "keywords": [
    "file-tree",
    "inventory",
    "duplicates",
    "offline",
    "privacy",
    "desktop"
  ],
  "author": "Archifiltre Team",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/tar-stream": "^3.1.4",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-yml": "^1.19.0",
    "prettier": "^3.1.0",
    "tar-stream": "^3.1.7",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "yaml-eslint-parser": "^1.3.0"
  },
  "dependencies": {
    "@oclif/core": "^4.0.0"
  },
  "oclif": {
    "bin": "archifiltre",
    "dirname": "archifiltre",
    "commands": {
      "strategy": "explicit",
      "target": "./src/commands.js",
      "identifier": "COMMANDS"
    },
    "helpClass": "./src/cli/help.js",
    "plugins": [],
    "topicSeparator": " ",
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProgrammeVitam/archifiltre.git"
  },
  "bugs": {
    "url": "https://github.com/ProgrammeVitam/archifiltre/issues"
  },
  "homepage": "https://github.com/ProgrammeVitam/archifiltre#readme"
}
