{
  "name": "archifiltre",
  "version": "5.0.0-alpha.3",
  "description": "Privacy-friendly, 100% offline desktop tool for inventorying large file trees",
  "type": "module",
  "bin": {
    "archifiltre": "./archifiltre"
  },
  "scripts": {
    "copy-wasm": "bun run scripts/copy-wasm.ts",
    "dev": "bun run src/main.ts",
    "expose-db": "bun run scripts/expose-db.ts",
    "expose-db:debug": "bun run scripts/expose-db.ts --debug",
    "expose-db:port": "bun run scripts/expose-db.ts --port=5433",
    "expose-db:help": "bun run scripts/expose-db.ts --help",
    "prebuild": "mkdir -p dist && bun run copy-wasm && bun run sbom",
    "build": "bun run prebuild && bun build src/main.ts --compile --external node-llama-cpp --external '@node-llama-cpp/*' --outfile dist/archifiltre --minify-syntax --minify-whitespace",
    "build:cli": "bun run prebuild && bun build src/main.ts --compile --external node-llama-cpp --external '@node-llama-cpp/*' --outfile dist/archifiltre --minify-syntax --minify-whitespace",
    "build:release": "bun run build && cp dist/sbom/archifiltre-*.spdx3.yaml ./archifiltre.sbom",
    "build:windows": "bun build src/main.ts --compile --external node-llama-cpp --external '@node-llama-cpp/*' --target=bun-windows-x64 --outfile dist/archifiltre-x86_64-pc-windows-msvc.exe --minify-syntax --minify-whitespace",
    "build:macos": "bun build src/main.ts --compile --external node-llama-cpp --external '@node-llama-cpp/*' --target=bun-darwin-x64 --outfile dist/archifiltre-x86_64-apple-darwin --minify-syntax --minify-whitespace",
    "build:macos-arm": "bun build src/main.ts --compile --external node-llama-cpp --external '@node-llama-cpp/*' --target=bun-darwin-arm64 --outfile dist/archifiltre-aarch64-apple-darwin --minify-syntax --minify-whitespace",
    "build:linux": "bun build src/main.ts --compile --external node-llama-cpp --external '@node-llama-cpp/*' --target=bun-linux-x64 --outfile dist/archifiltre-x86_64-unknown-linux-gnu --minify-syntax --minify-whitespace",
    "build:all": "bun run prebuild && bun run build:linux && bun run build:windows && bun run build:macos && bun run build:macos-arm",
    "package:dmg": "scripts/create-dmg.sh",
    "smoke:cli": "bun run scripts/smoke-test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "lint": "eslint src test scripts --ext .ts",
    "lint:fix": "eslint src test scripts --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:pack": "bun run scripts/release-pack.ts",
    "typecheck": "tsc --noEmit",
    "security:audit": "bun run scripts/security-audit.ts",
    "security:audit:ci": "bun run scripts/security-audit.ts --ci --severity high",
    "security:audit:json": "bun run scripts/security-audit.ts --json --output security-report.json",
    "security:audit:quick": "bun run scripts/security-audit.ts --skip-semgrep --quiet",
    "sbom": "bun run scripts/generate-spdx3-sbom.ts --output-dir dist/sbom",
    "sbom:compliance": "bun run scripts/generate-spdx3-sbom.ts --output-dir dist/compliance-sbom --verbose",
    "sbom:security": "bun run scripts/generate-spdx3-sbom.ts --output-dir dist/security-sbom --verbose",
    "sbom:dev": "bun run scripts/generate-spdx3-sbom.ts --output-dir dist/dev-sbom --verbose --force-rebuild",
    "smoke:linux": "bun run scripts/smoke-test.ts linux",
    "smoke:windows": "bun run scripts/smoke-test.ts windows"
  },
  "keywords": [
    "file-tree",
    "inventory",
    "duplicates",
    "offline",
    "privacy",
    "desktop",
    "government",
    "vitam",
    "france",
    "ministry-of-culture",
    "compliance",
    "sbom"
  ],
  "author": {
    "name": "République française – Ministère de la Culture (SNUM/SIAF)",
    "email": "archifiltre@culture.gouv.fr",
    "url": "https://www.archifiltre.org"
  },
  "license": "Apache-2.0",
  "homepage": "https://www.archifiltre.org",
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/tar-stream": "^3.1.4",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "bun-types": "^1.3.14",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-yml": "^3.3.2",
    "pglite-server": "^0.1.5",
    "prettier": "^3.8.3",
    "tar-stream": "^3.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "yaml-eslint-parser": "^2.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@node-llama-cpp/linux-x64": "^3.19.0",
    "@node-llama-cpp/linux-x64-vulkan": "^3.19.0",
    "@node-llama-cpp/win-x64": "^3.19.0",
    "@node-llama-cpp/win-x64-vulkan": "^3.19.0",
    "@oclif/core": "^4.11.4",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "node-llama-cpp": "^3.19.0",
    "rxjs": "^7.8.2",
    "smol-toml": "^1.6.1",
    "streamarchive": "^0.1.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "oclif": {
    "bin": "archifiltre",
    "dirname": "archifiltre",
    "commands": {
      "strategy": "explicit",
      "target": ".",
      "identifier": "COMMANDS"
    },
    "topicSeparator": " ",
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProgrammeVitam/archifiltre.git"
  },
  "bugs": {
    "url": "https://github.com/ProgrammeVitam/archifiltre/issues",
    "email": "archifiltre@culture.gouv.fr"
  },
  "funding": {
    "type": "government",
    "url": "https://www.programmevitam.fr/"
  },
  "trustedDependencies": [
    "node-llama-cpp"
  ]
}
