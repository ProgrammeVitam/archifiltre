{
  "name": "archifiltre",
  "version": "5.0.0-dev",
  "description": "Privacy-friendly, 100% offline desktop tool for inventorying large file trees",
  "type": "module",
  "bin": {
    "archifiltre": "./archifiltre"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "expose-db": "bun run scripts/expose-db.ts",
    "expose-db:debug": "bun run scripts/expose-db.ts --debug",
    "expose-db:port": "bun run scripts/expose-db.ts --port=5433",
    "expose-db:help": "bun run scripts/expose-db.ts --help",
    "prebuild": "mkdir -p dist && bun run sbom",
    "build": "bun run prebuild && bun build src/main.ts --compile --outfile dist/archifiltre --minify-syntax --minify-whitespace",
    "build:cli": "bun run prebuild && bun build src/main.ts --compile --outfile dist/archifiltre --minify-syntax --minify-whitespace",
    "build:release": "bun run build && cp dist/sbom/archifiltre-*.spdx3.yaml ./archifiltre.sbom",
    "build:windows": "bun build src/main.ts --compile --target=bun-windows-x64 --outfile dist/archifiltre-windows.exe --minify-syntax --minify-whitespace",
    "build:macos": "bun build src/main.ts --compile --target=bun-darwin-x64 --outfile dist/archifiltre-macos --minify-syntax --minify-whitespace",
    "build:macos-arm": "bun build src/main.ts --compile --target=bun-darwin-arm64 --outfile dist/archifiltre-macos-arm64 --minify-syntax --minify-whitespace",
    "build:linux": "bun build src/main.ts --compile --target=bun-linux-x64 --outfile dist/archifiltre-linux --minify-syntax --minify-whitespace",
    "build:all": "bun run prebuild && bun run build:linux && bun run build:windows && bun run build:macos && bun run build:macos-arm",
    "package:dmg": "scripts/create-dmg.sh",
    "smoke:cli": "bun run scripts/smoke-test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "lint": "eslint src test scripts --ext .ts",
    "lint:fix": "eslint src test scripts --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:pack": "bun run scripts/release-pack.ts",
    "typecheck": "tsc --noEmit",
    "security:audit": "bun run scripts/security-audit.ts",
    "security:audit:ci": "bun run scripts/security-audit.ts --ci --severity high",
    "security:audit:json": "bun run scripts/security-audit.ts --json --output security-report.json",
    "security:audit:quick": "bun run scripts/security-audit.ts --skip-semgrep --quiet",
    "sbom": "bun run scripts/generate-spdx3-sbom.ts --output-dir dist/sbom",
    "sbom:compliance": "bun run scripts/generate-spdx3-sbom.ts --output-dir dist/compliance-sbom --verbose",
    "sbom:security": "bun run scripts/generate-spdx3-sbom.ts --output-dir dist/security-sbom --verbose",
    "sbom:dev": "bun run scripts/generate-spdx3-sbom.ts --output-dir dist/dev-sbom --verbose --force-rebuild"
  },
  "keywords": [
    "file-tree",
    "inventory",
    "duplicates",
    "offline",
    "privacy",
    "desktop",
    "government",
    "vitam",
    "france",
    "ministry-of-culture",
    "compliance",
    "sbom"
  ],
  "author": {
    "name": "République française – Ministère de la Culture (SNUM) / CIAF / DINUM",
    "email": "archifiltre@programmevitam.fr",
    "url": "https://archifiltre.fabrique.social.gouv.fr"
  },
  "license": "Apache-2.0",
  "homepage": "https://archifiltre.fabrique.social.gouv.fr",
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/tar-stream": "^3.1.4",
    "@types/uuid": "^10.0.0",
    "@types/winston": "^2.4.4",
    "@types/winston-syslog": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-yml": "^1.19.0",
    "pglite-server": "^0.1.4",
    "prettier": "^3.7.3",
    "tar-stream": "^3.1.7",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1",
    "yaml-eslint-parser": "^1.3.1"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@node-rs/xxhash": "^1.7.6",
    "@oclif/core": "^4.8.0",
    "@sentry/node": "^10.27.0",
    "ajv": "^8.17.1",
    "bottleneck": "^2.19.5",
    "drizzle-orm": "^0.44.7",
    "js-yaml": "^4.1.1",
    "libarchive-wasm": "^1.2.0",
    "posthog-node": "^5.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "smol-toml": "^1.5.2",
    "tsyringe": "^4.10.0",
    "uuid": "^11.1.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-syslog": "^2.7.1"
  },
  "oclif": {
    "bin": "archifiltre",
    "dirname": "archifiltre",
    "commands": {
      "strategy": "explicit",
      "target": ".",
      "identifier": "COMMANDS"
    },
    "topicSeparator": " ",
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProgrammeVitam/archifiltre.git"
  },
  "bugs": {
    "url": "https://github.com/ProgrammeVitam/archifiltre/issues",
    "email": "archifiltre@programmevitam.fr"
  },
  "funding": {
    "type": "government",
    "url": "https://www.programmevitam.fr/"
  }
}
